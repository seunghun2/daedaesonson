	<script>
		var lastScrollTop = 0, delta = 15;
		
		$(window).scroll(function(){
			var scrollTop = $(this).scrollTop();
			if (Math.abs(lastScrollTop - scrollTop) <= delta)
				return;
			if ((scrollTop > lastScrollTop) && (lastScrollTop > 10)) {
				$("#headerSn").addClass('down_header');
			} else {
				$("#headerSn").removeClass('down_header');
			}
			lastScrollTop = scrollTop;
			if ($(".headerRight").hasClass("show")) {	
				$("#headerSn").removeClass("down_header");
			}
		});

		$(window).scroll(function() {
			var scroll = $(window).scrollTop();
			if (scroll >= 10) {
				$("#headerSn").addClass("change");
			} else {
				$("#headerSn").removeClass("change");
			}
		});
		
		$(".moMenuBtn").click(function(){
			$(".headerSnGnb").addClass("show")
			$(".moMenuBtn").hide();
			$(".menuCloseBtn").addClass("show")
			$("body").addClass("sbhidden");
		});
		
		$(".menuCloseBtn").click(function(){
			$(".headerSnGnb").removeClass("show")
			$(".moMenuBtn").show();
			$(".menuCloseBtn").removeClass("show")
			$("body").removeClass("sbhidden");
		});
		
		$(".sngnb li a").click(function(){
			$(this).toggleClass("depth02Show")
			$(".depthArrow").removeClass("depth02Show")
			$(this).siblings().toggleClass("depth02Show")
		});
	</script>
	
	
	
