		<script language="javascript">


		function fn_error(){
		alert('잠시 후 다시 이용해주세요.');
		}

		function satisSubmit(){


		var comments  = satisFrm.comments.value;
		//-----------------------------------------------------------------
		if (comments == "")
		{
			alert('의견을 입력해주세요.');
			satisFrm.comments.focus(); 
			return false;
		}

		var string = $("form[name=satisFrm]").serialize();

		$.ajax({   
			 type: "POST",  
			 url: "/common/class/ajax_satis_send.asp",   
			 data: string,   
			 success:function(msg){
					if (msg == "Y")
					{
						alert('등록되었습니다.');
						satisFrm.comments.value = ""; 
						satisFrm.point[0].checked = true; 
					}else{
						alert('잠시 후 다시 이용해주세요.');
					}
					
			 },
			 error: fn_error
		 }
		);


		return false;

		}

		</script>


